default_platform(:ios)

platform :ios do
  desc "Build and release iOS app with Shorebird"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "AuthKey.p8",
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true,
      app_identifier: ["com.trendflow.bread", "com.trendflow.bread.dev"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    increment_build_number(build_number: ENV["BUILD_NUMBER"])
    increment_version_number(version_number: ENV["VERSION_NUMBER"])

    cocoapods(
      repo_update: false,
      use_bundle_exec: true,
    )

    # Flavor에 따른 entry point 설정
    entry_point = case ENV["MODE"]
    when "dev"
      "lib/src/main_dev.dart"
    when "prod"
      "lib/src/main_prod.dart"
    else
      "lib/src/main_dev.dart"
    end

    shorebird_release(
      platform: "ios",
      args: "--flutter-version=#{ENV["FLUTTER_VERSION"]} --build-name=#{ENV["VERSION"]} --build-number=#{ENV["BUILD_NUMBER"]} -t #{entry_point} --flavor #{ENV["MODE"]}",
      export_options: ENV['EXPORT_OPTIONS_PLIST']
    )

    rescue => exception
      handle_asset_changes_error(exception)
      raise exception
  end

  desc "Create a patch for existing release"
  lane :patch do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "AuthKey.p8",
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true,
      app_identifier: ["com.trendflow.bread", "com.trendflow.bread.dev"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    # Flavor에 따른 entry point 설정
    entry_point = case ENV["MODE"]
    when "dev"
      "lib/src/main_dev.dart"
    when "prod"
      "lib/src/main_prod.dart"
    else
      "lib/src/main_dev.dart"
    end

    # 기본 args 설정
    patch_args = "-t #{entry_point} --release-version #{ENV["VERSION"]}+#{ENV["PATCH_BUILD_NUMBER"]} --flavor #{ENV["MODE"]}"

    shorebird_patch(
      platform: "ios",
      args: patch_args,
      export_options: ENV['EXPORT_OPTIONS_PLIST']
    )

    rescue => exception
      handle_asset_changes_error(exception)
      raise exception
  end

  desc "Distribute iOS build to Firebase App Distribution"
  lane :distribute do
    # Shorebird release IPA가 이미 빌드되었다고 가정하고 배포만 진행
    flavor = ENV["MODE"] || "dev"

    # Flavor에 따른 Firebase App ID 설정
    firebase_app_id = if flavor == "dev"
      ENV["FIREBASE_APP_ID_IOS_DEV"]
    else
      ENV["FIREBASE_APP_ID_IOS"]
    end

    # 여러 가능한 IPA 경로 확인
    possible_ipa_paths = [
      "../../build/ios/ipa/magambell.ipa",
      "../../build/ios/archive/Runner.xcarchive/Products/Applications/Runner.app"
    ]

    ipa_path = nil
    possible_ipa_paths.each do |path|
      if File.exist?(path)
        ipa_path = File.expand_path(path)  # 절대 경로로 변환
        puts "📦 IPA 파일 확인됨: #{ipa_path}"
        break
      else
        puts "🔍 IPA 파일 확인 중: #{path} - 없음"
      end
    end

    unless ipa_path
      puts "❌ IPA 파일을 찾을 수 없습니다!"
      puts "확인한 경로들:"
      possible_ipa_paths.each { |path| puts "  - #{path}" }
      puts "현재 작업 디렉터리: #{Dir.pwd}"
      raise "IPA file not found"
    end

    # Distribute to Firebase App Distribution
    puts "🔍 Firebase App Distribution 설정 확인:"
    puts "  - App ID: #{firebase_app_id}"
    puts "  - Flavor: #{flavor}"
    puts "  - IPA Path: #{ipa_path}"
    puts "  - Google Credentials: #{ENV["GOOGLE_APPLICATION_CREDENTIALS"] ? "설정됨" : "미설정"}"

    # Firebase App ID가 없으면 에러
    if firebase_app_id.nil? || firebase_app_id.empty?
      raise "Firebase App ID is not set. Please check FIREBASE_APP_ID_IOS or FIREBASE_APP_ID_IOS_DEV environment variable."
    end

    firebase_app_distribution(
      app: firebase_app_id,
      ipa_path: ipa_path,
      release_notes: "Shorebird Release Build #{ENV["BUILD_NUMBER"]} - #{ENV["VERSION"]}\n배포 시간: #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}\nFlavor: #{flavor}\n🐦 Shorebird 코드 푸시 지원",
      groups: "qa-testers"
    )

    puts "✅ Shorebird Firebase App Distribution 배포 완료!"

    rescue => exception
      puts "❌ Firebase App Distribution 배포 실패: #{exception.message}"
      raise exception
  end
end

# Handle asset changes error
def handle_asset_changes_error(exception)
  return unless exception.message.match(/\[WARN\].*asset changes.*will not be included/)

  changed_files = extract_changed_files(exception.message)

  unless changed_files.empty?
    allowed_files = ['base/assets/sentry-debug-meta.properties']
    unauthorized = changed_files - allowed_files

    unless unauthorized.empty?
      message = "[iOS-#{ENV["MODE"]}] Unauthorized asset file changes detected: #{unauthorized.join(', ')}"
      puts message
    end
  end
end

def extract_changed_files(message)
  changed_files = []
  lines = message.split("\n")
  capturing = false

  lines.each do |line|
    if line.include?('Changed files:')
      capturing = true
      next
    end

    break if capturing && line.include?('Fetching')

    if capturing && !line.strip.empty?
      cleaned_line = line.strip
      # 타임스탬프와 아이콘 제거
      cleaned_line = cleaned_line.gsub(/^\[.*?\]:\s*/, '')
      cleaned_line = cleaned_line.gsub(/^▸\s*/, '')

      # 파일 경로 형태인지 확인
      if !cleaned_line.empty? && cleaned_line.match(/^[a-zA-Z0-9\/\.\-_]+$/)
        changed_files << cleaned_line
      end
    end
  end

  changed_files
end
