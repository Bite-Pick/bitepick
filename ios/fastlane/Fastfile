default_platform(:ios)

platform :ios do
  desc "Build and release iOS app with Shorebird"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "AuthKey.p8",
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true,
      force_for_new_devices: true,
      app_identifier: ["com.trendflow.bread", "com.trendflow.bread.dev"],
      git_url: "https://github.com/NewProject2025/ios-certifcate",
      git_branch: "main",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    sh('flutter pub get')

    # Clean version number (remove 'v' prefix and flavor suffix like '-dev', '-prod', '-ios')
    clean_version = ENV["VERSION_NUMBER"].sub(/^v/, '').gsub(/-(dev|prod|ios|android)/, '')
    puts "📦 Using clean version: #{clean_version}"

    increment_build_number(build_number: ENV["BUILD_NUMBER"])
    increment_version_number(version_number: clean_version)

    cocoapods(
      repo_update: false,
      use_bundle_exec: true,
    )

    # Flavor에 따른 entry point 설정
    entry_point = case ENV["MODE"]
    when "dev"
      "lib/src/main_dev.dart"
    when "prod"
      "lib/src/main_prod.dart"
    else
      "lib/src/main_dev.dart"
    end

    # 동적으로 export_options.plist 생성
    # match에서 생성된 프로비저닝 프로파일 매핑 사용
    provisioning_profiles = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    export_options = {
      method: "app-store",
      teamID: "JM239C9WFM",
      provisioningProfiles: provisioning_profiles,
      signingStyle: "manual",
      uploadBitcode: false,
      uploadSymbols: true,
      compileBitcode: false,
      manageAppVersionAndBuildNumber: false
    }

    # export_options를 plist 파일로 저장
    export_options_path = "/tmp/export_options_#{ENV["MODE"]}.plist"
    File.write(export_options_path, Plist::Emit.dump(export_options))

    puts "✅ 동적으로 생성된 export_options.plist:"
    puts "   경로: #{export_options_path}"
    puts "   프로비저닝 프로파일: #{provisioning_profiles}"

    begin
      shorebird_release(
        platform: "ios",
        args: "--flutter-version=#{ENV["FLUTTER_VERSION"]} --build-name=#{clean_version} --build-number=#{ENV["BUILD_NUMBER"]} -t #{entry_point} --flavor #{ENV["MODE"]}",
        export_options: export_options_path
      )
    rescue => e
      puts "❌ Shorebird release failed with error: #{e.message}"

      # Try to find and display Shorebird logs
      log_dir = File.expand_path("~/Library/Application Support/shorebird/logs")
      if Dir.exist?(log_dir)
        latest_log = Dir.glob("#{log_dir}/*_shorebird.log").max_by { |f| File.mtime(f) }
        if latest_log
          puts "\n📄 Latest Shorebird log (#{latest_log}):"
          puts File.read(latest_log)
        end
      end

      raise e
    end

    # IPA 파일 경로 찾기 (여러 경로 시도)
    possible_paths = [
      "../build/ios/ipa/*.ipa",
      "../../build/ios/ipa/*.ipa",
      "./build/ios/ipa/*.ipa"
    ]

    ipa_path = nil
    possible_paths.each do |pattern|
      found = Dir[pattern].first
      if found
        ipa_path = found
        break
      end
    end

    if ipa_path.nil?
      # 디버깅을 위한 상세 정보 출력
      puts "❌ IPA 파일을 찾을 수 없습니다."
      puts "🔍 현재 디렉토리: #{Dir.pwd}"
      puts "🔍 탐색한 경로들:"
      possible_paths.each do |pattern|
        puts "   - #{pattern}"
      end

      # build/ios/ipa 디렉토리 확인
      ipa_dir = "../build/ios/ipa"
      if Dir.exist?(ipa_dir)
        puts "📁 #{ipa_dir} 디렉토리 내용:"
        Dir.entries(ipa_dir).each { |f| puts "   - #{f}" }
      else
        puts "❌ #{ipa_dir} 디렉토리가 존재하지 않습니다."
      end

      UI.user_error!("IPA 파일을 찾을 수 없습니다. 위의 디버깅 정보를 확인하세요.")
    end

    # 절대 경로로 변환
    absolute_ipa_path = File.expand_path(ipa_path)

    puts "✅ IPA 파일 발견: #{ipa_path}"
    puts "📦 절대 경로: #{absolute_ipa_path}"

    # TestFlight에 업로드
    upload_to_testflight(
      api_key: api_key,
      ipa: absolute_ipa_path,
      skip_waiting_for_build_processing: false,
      team_id: "JM239C9WFM"
    )

    rescue => exception
      handle_asset_changes_error(exception)
      raise exception
  end

  desc "Create a patch for existing release"
  lane :patch do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "AuthKey.p8",
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: true,
      force_for_new_devices: true,
      app_identifier: ["com.trendflow.bread", "com.trendflow.bread.dev"],
      git_url: "https://github.com/NewProject2025/ios-certifcate",
      git_branch: "main",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    )

    sh('flutter pub get')

    # Flavor에 따른 entry point 설정
    entry_point = case ENV["MODE"]
    when "dev"
      "lib/src/main_dev.dart"
    when "prod"
      "lib/src/main_prod.dart"
    else
      "lib/src/main_dev.dart"
    end

    # 기본 args 설정 (release lane과 동일하게 suffix 제거)
    clean_version = ENV["VERSION"].sub(/^v/, '').gsub(/-(dev|prod|ios|android)/, '')
    patch_args = "-t #{entry_point} --release-version #{clean_version}+#{ENV["PATCH_BUILD_NUMBER"]} --flavor #{ENV["MODE"]}"

    shorebird_patch(
      platform: "ios",
      args: patch_args
    )

    rescue => exception
      handle_asset_changes_error(exception)
      raise exception
  end

end

# Handle asset changes error
def handle_asset_changes_error(exception)
  return unless exception.message.match(/\[WARN\].*asset changes.*will not be included/)

  changed_files = extract_changed_files(exception.message)

  unless changed_files.empty?
    allowed_files = ['base/assets/sentry-debug-meta.properties']
    unauthorized = changed_files - allowed_files

    unless unauthorized.empty?
      message = "[iOS-#{ENV["MODE"]}] Unauthorized asset file changes detected: #{unauthorized.join(', ')}"
      puts message
    end
  end
end

def extract_changed_files(message)
  changed_files = []
  lines = message.split("\n")
  capturing = false

  lines.each do |line|
    if line.include?('Changed files:')
      capturing = true
      next
    end

    break if capturing && line.include?('Fetching')

    if capturing && !line.strip.empty?
      cleaned_line = line.strip
      # 타임스탬프와 아이콘 제거
      cleaned_line = cleaned_line.gsub(/^\[.*?\]:\s*/, '')
      cleaned_line = cleaned_line.gsub(/^▸\s*/, '')

      # 파일 경로 형태인지 확인
      if !cleaned_line.empty? && cleaned_line.match(/^[a-zA-Z0-9\/\.\-_]+$/)
        changed_files << cleaned_line
      end
    end
  end

  changed_files
end
